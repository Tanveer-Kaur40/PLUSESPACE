<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create account · PulseSpace</title>
    <link rel="stylesheet" href="/css/style.css">
    <script src="/js/theme.js"></script>
</head>
<body class="auth-page">
    <main class="auth-shell">
        <button class="theme-toggle auth-theme-toggle" type="button" data-theme-toggle></button>
        <a class="brand auth-brand" href="/"><span class="brand-mark">P</span><span>PulseSpace</span></a>
        <section class="auth-card">
            <p class="eyebrow">JOIN THE COMMUNITY</p>
            <h1>Make some space for ideas.</h1>
            <p class="auth-subtitle">Create your account and start building a feed that feels like you.</p>
            <% if (error) { %><p class="form-error" role="alert"><%= error %></p><% } %>
            <form method="post" action="/signup" class="auth-form">
                <label for="name">Your name</label>
                <input id="name" name="name" type="text" value="<%= form?.name || '' %>" autocomplete="name" required>
                <label for="email">Email address</label>
                <input id="email" name="email" type="email" value="<%= form?.email || '' %>" autocomplete="email" required>
                <label for="password">Password <span>(8+ characters)</span></label>
                <input id="password" name="password" type="password" autocomplete="new-password" minlength="8" required>
                <button class="button button-primary button-large" type="submit">Create account <span aria-hidden="true">→</span></button>
            </form>
            <p class="auth-switch">Already have an account? <a href="/login">Sign in</a></p>
        </section>
        <a class="back-link" href="/">← Back to about PulseSpace</a>
    </main>
</body>
</html>
